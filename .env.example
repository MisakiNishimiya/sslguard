# SSLGuard Environment Variables
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False
SSLGUARD_SECRET_KEY=your-super-secret-key-change-this-in-production

# Database (Railway/Render will provide DATABASE_URL)
# Leave empty to use SQLite, or use PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# SMTP Configuration (for email alerts)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=sslguard@yourdomain.com

# Application Settings
SCAN_TIMEOUT=10
DAILY_SCAN_HOUR=2
